
import React, { useState, useEffect } from "react";
import { Note } from "@/entities/Note";
import { Plus, Search, SortDesc, Grid, List, X, MessageCircle } from "lucide-react";
import NoteItem from "./NoteItem";
import { Link, useLocation } from "react-router-dom";
import { createPageUrl } from "@/utils";
import { routes } from "./utils/routing";

export default function NotesList({ folder = "All Notes", isArchive = false }) {
  const [notes, setNotes] = useState([]);
  const [loading, setLoading] = useState(true);
  const [searchQuery, setSearchQuery] = useState("");
  const [sortBy, setSortBy] = useState("-last_modified");
  const [viewMode, setViewMode] = useState("list"); // list or grid
  const location = useLocation();
  
  const selectedNoteId = new URLSearchParams(location.search).get("id");

  useEffect(() => {
    loadNotes();
  }, [folder, isArchive, sortBy]);

  const loadNotes = async () => {
    setLoading(true);
    try {
      let query = {};
      
      // Filter by folder
      if (folder !== "All Notes") {
        query.folder = folder;
      }
      
      // Filter archived notes
      query.is_archived = isArchive;
      
      // Get notes
      let notesList = await Note.filter(query, sortBy);
      
      // Sort pinned notes to top if sorting by date
      if (sortBy.includes("last_modified") || sortBy.includes("created_date")) {
        notesList = [...notesList.filter(n => n.is_pinned), ...notesList.filter(n => !n.is_pinned)];
      }
      
      setNotes(notesList);
    } catch (error) {
      console.error("Error loading notes:", error);
    } finally {
      setLoading(false);
    }
  };

  const filteredNotes = searchQuery
    ? notes.filter(
        note =>
          note.title?.toLowerCase().includes(searchQuery.toLowerCase()) ||
          note.content?.toLowerCase().includes(searchQuery.toLowerCase())
      )
    : notes;
  
  const clearSearch = () => {
    setSearchQuery("");
  };

  const renderEmptyState = () => {
    if (loading) {
      return (
        <div className="p-8 text-center text-[var(--text-secondary)]">
          <div className="animate-spin rounded-full h-10 w-10 border-b-2 border-[var(--accent)] mx-auto mb-4"></div>
          <p className="font-medium">Loading notes...</p>
        </div>
      );
    }
    
    if (searchQuery && filteredNotes.length === 0) {
      return (
        <div className="flex flex-col items-center justify-center h-full text-[var(--text-secondary)] p-8">
          <Search size={36} className="mb-3 text-[var(--text-secondary)] opacity-30" />
          <p className="text-center mb-2">No results found for "{searchQuery}"</p>
          <button 
            onClick={clearSearch}
            className="text-[var(--accent)] hover:underline text-sm"
          >
            Clear search
          </button>
        </div>
      );
    }
    
    if (filteredNotes.length === 0) {
      return (
        <div className="flex flex-col items-center justify-center h-full text-[var(--text-secondary)] p-8">
          <MessageCircle size={40} className="mb-3 text-[var(--text-secondary)] opacity-30" />
          <p className="mb-3 text-center">
            {isArchive ? "No archived notes yet" : "No notes yet"}
          </p>
          {!isArchive && (
            <Link
              to={createPageUrl("NoteEdit")}
              className="px-4 py-2 rounded-md bg-[var(--accent)] text-white flex items-center"
            >
              <Plus size={16} className="mr-2" /> Create your first note
            </Link>
          )}
        </div>
      );
    }
    
    return null;
  };

  return (
    <div className="flex flex-col h-full border-r border-[var(--border-color)]">
      {/* Header */}
      <div className="p-3 border-b border-[var(--border-color)] flex-shrink-0">
        <div className="flex items-center justify-between mb-3">
          <h2 className="text-lg font-medium text-[var(--text-primary)]">
            {isArchive ? "Archive" : folder}
          </h2>
          <div className="flex space-x-1">
            <button
              className={`p-1.5 rounded ${viewMode === "list" ? "bg-[var(--sidebar-bg)]" : "hover:bg-[var(--sidebar-hover)]"}`}
              onClick={() => setViewMode("list")}
            >
              <List size={18} />
            </button>
            <button
              className={`p-1.5 rounded ${viewMode === "grid" ? "bg-[var(--sidebar-bg)]" : "hover:bg-[var(--sidebar-hover)]"}`}
              onClick={() => setViewMode("grid")}
            >
              <Grid size={18} />
            </button>
          </div>
        </div>
        <div className="relative">
          <input
            type="text"
            value={searchQuery}
            onChange={(e) => setSearchQuery(e.target.value)}
            placeholder="Search notes"
            className="w-full py-2 pl-9 pr-9 rounded-md bg-[var(--sidebar-bg)] text-[var(--text-primary)] placeholder-[var(--text-secondary)] outline-none border border-transparent focus:border-[var(--accent)]"
          />
          <Search size={18} className="absolute left-3 top-2.5 text-[var(--text-secondary)]" />
          {searchQuery && (
            <button
              onClick={clearSearch}
              className="absolute right-3 top-2.5 text-[var(--text-secondary)] hover:text-[var(--text-primary)]"
            >
              <X size={18} />
            </button>
          )}
        </div>
      </div>

      {/* Notes List */}
      <div className="flex-1 overflow-y-auto bg-[var(--note-bg)]">
        {renderEmptyState() || (
          <div className={viewMode === "grid" ? "grid grid-cols-2 gap-0.5" : ""}>
            {filteredNotes.map((note) => (
              <NoteItem
                key={note.id}
                note={note}
                isSelected={selectedNoteId === note.id}
              />
            ))}
          </div>
        )}
      </div>

      {/* Footer with Button */}
      <div className="p-3 border-t border-[var(--border-color)] flex-shrink-0">
        <Link
          to={routes.noteEdit}
          className="flex items-center justify-center py-2 rounded-md bg-[var(--accent)] hover:bg-[var(--accent-light)] text-white transition-colors"
        >
          <Plus size={18} className="mr-2" />
          New Note
        </Link>
      </div>
    </div>
  );
}
