import React, { useState, useRef, useEffect } from 'react';
import { Bot, User, Send, X, AlertCircle, Info } from 'lucide-react';
import { Alert, AlertDescription } from "@/components/ui/alert";

export default function PerplexityChat() {
  const [messages, setMessages] = useState([
    {
      role: 'assistant',
      content: 'Hello! I can help you with your study questions. What would you like to know?'
    }
  ]);
  const [input, setInput] = useState('');
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState(null);
  const [apiKey, setApiKey] = useState('');
  const [apiKeySet, setApiKeySet] = useState(false);
  const messagesEndRef = useRef(null);

  // Check for API key in localStorage on mount
  useEffect(() => {
    const storedKey = localStorage.getItem('perplexity_api_key');
    if (storedKey) {
      setApiKey(storedKey);
      setApiKeySet(true);
    }
  }, []);

  useEffect(() => {
    scrollToBottom();
  }, [messages]);

  const scrollToBottom = () => {
    messagesEndRef.current?.scrollIntoView({ behavior: 'smooth' });
  };

  const saveApiKey = () => {
    if (apiKey.trim()) {
      localStorage.setItem('perplexity_api_key', apiKey);
      setApiKeySet(true);
      setError(null);
    } else {
      setError('Please enter a valid API key');
    }
  };

  const clearApiKey = () => {
    localStorage.removeItem('perplexity_api_key');
    setApiKey('');
    setApiKeySet(false);
  };

  const handleSubmit = async (e) => {
    e.preventDefault();
    if (!input.trim() || loading) return;
    if (!apiKeySet) {
      setError('Please set your Perplexity API key first');
      return;
    }

    // Add user message immediately
    setMessages(prev => [...prev, { role: 'user', content: input }]);
    const currentInput = input;
    setInput('');
    setLoading(true);
    setError(null);

    try {
      const storedKey = localStorage.getItem('perplexity_api_key');
      
      const response = await fetch('https://api.perplexity.ai/chat/completions', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${storedKey}`
        },
        body: JSON.stringify({
          model: 'mistral-7b-instruct',
          messages: [
            { 
              role: 'system', 
              content: 'You are a helpful study assistant. Your answers should be educational, accurate, and focus on helping the student understand concepts thoroughly. Provide examples when appropriate.' 
            },
            ...messages.map(msg => ({ role: msg.role, content: msg.content })),
            { role: 'user', content: currentInput }
          ]
        })
      });

      if (!response.ok) {
        const errorData = await response.json().catch(() => ({}));
        throw new Error(errorData.error?.message || `Error: ${response.status}`);
      }

      const data = await response.json();
      setMessages(prev => [...prev, { 
        role: 'assistant', 
        content: data.choices[0].message.content 
      }]);
    } catch (err) {
      console.error('Perplexity API Error:', err);
      
      // If it's a network error or API not available
      if (err.message.includes('NetworkError') || err.message.includes('Failed to fetch')) {
        setMessages(prev => [...prev, { 
          role: 'assistant', 
          content: "I'm having trouble connecting to the Perplexity API. Please check your internet connection or try again later." 
        }]);
      } else {
        setMessages(prev => [...prev, { 
          role: 'assistant', 
          content: `Sorry, there was an error processing your request: ${err.message}. Please check your API key or try again later.` 
        }]);
      }
      
      // If authentication error, clear the API key
      if (err.message && (
        err.message.includes('authentication') || 
        err.message.includes('Authorization') || 
        err.message.includes('401')
      )) {
        setApiKeySet(false);
        setError('API key seems invalid. Please check and update your key.');
      }
    } finally {
      setLoading(false);
    }
  };

  return (
    <div className="h-full flex flex-col bg-[var(--note-bg)] border-l border-[var(--border-color)]">
      {/* Header */}
      <div className="p-4 border-b border-[var(--border-color)]">
        <div className="flex items-center justify-between">
          <div className="flex items-center space-x-2">
            <Bot className="w-5 h-5 text-[var(--accent)]" />
            <h2 className="text-lg font-medium">Study Assistant</h2>
          </div>
          {apiKeySet && (
            <button
              onClick={() => setApiKeySet(false)}
              className="text-xs text-[var(--accent)] hover:underline"
            >
              Change API Key
            </button>
          )}
        </div>
        <p className="text-sm text-[var(--text-secondary)] mt-1">
          Get help with your study questions
        </p>
      </div>

      {!apiKeySet ? (
        <div className="flex-1 p-4 flex flex-col items-center justify-center">
          <div className="max-w-md w-full space-y-4">
            <div className="text-center mb-6">
              <Bot size={40} className="mx-auto text-[var(--accent)]" />
              <h3 className="mt-2 text-lg font-medium">Setup Perplexity API</h3>
              <p className="text-sm text-[var(--text-secondary)]">
                Enter your Perplexity API key to enable the AI assistant.
                Your key is stored locally and never sent to our servers.
              </p>
            </div>
            
            {error && (
              <Alert variant="destructive">
                <AlertCircle className="h-4 w-4" />
                <AlertDescription>{error}</AlertDescription>
              </Alert>
            )}
            
            <div className="space-y-2">
              <label htmlFor="api-key" className="text-sm font-medium">
                API Key
              </label>
              <input
                id="api-key"
                type="password"
                value={apiKey}
                onChange={(e) => setApiKey(e.target.value)}
                placeholder="pplx-xxxxxxxxxxxxxxxx"
                className="w-full px-3 py-2 border border-[var(--border-color)] rounded-md bg-[var(--sidebar-bg)] focus:outline-none focus:ring-2 focus:ring-[var(--accent)]"
              />
            </div>
            
            <div className="flex justify-center">
              <button
                onClick={saveApiKey}
                className="px-4 py-2 bg-[var(--accent)] text-white rounded-md hover:bg-[var(--accent-light)]"
              >
                Save API Key
              </button>
            </div>
            
            <Alert className="bg-blue-50 dark:bg-blue-900/20 border-blue-200 dark:border-blue-800">
              <Info className="h-4 w-4" />
              <AlertDescription className="text-xs">
                You can get a Perplexity API key by signing up at{" "}
                <a 
                  href="https://www.perplexity.ai/api" 
                  target="_blank"
                  rel="noopener noreferrer"
                  className="text-[var(--accent)] hover:underline"
                >
                  perplexity.ai/api
                </a>
              </AlertDescription>
            </Alert>
          </div>
        </div>
      ) : (
        <>
          {/* Messages */}
          <div className="flex-1 overflow-y-auto p-4 space-y-4">
            {messages.map((message, index) => (
              <div
                key={index}
                className={`flex ${message.role === 'user' ? 'justify-end' : 'justify-start'}`}
              >
                <div
                  className={`max-w-[80%] rounded-lg p-3 ${
                    message.role === 'user'
                      ? 'bg-[var(--accent)] text-white'
                      : 'bg-[var(--sidebar-bg)]'
                  }`}
                >
                  <div className="flex items-center gap-2 mb-1">
                    {message.role === 'assistant' ? (
                      <><Bot size={14} /> <span className="text-xs font-medium">Assistant</span></>
                    ) : (
                      <><User size={14} /> <span className="text-xs font-medium">You</span></>
                    )}
                  </div>
                  <p className="text-sm whitespace-pre-wrap">{message.content}</p>
                </div>
              </div>
            ))}
            {loading && (
              <div className="flex justify-start">
                <div className="bg-[var(--sidebar-bg)] rounded-lg p-3">
                  <div className="flex items-center gap-2 mb-1">
                    <Bot size={14} />
                    <span className="text-xs font-medium">Assistant</span>
                  </div>
                  <div className="flex items-center gap-1">
                    <div className="w-2 h-2 rounded-full bg-[var(--accent)] animate-bounce" />
                    <div className="w-2 h-2 rounded-full bg-[var(--accent)] animate-bounce" style={{ animationDelay: '0.2s' }} />
                    <div className="w-2 h-2 rounded-full bg-[var(--accent)] animate-bounce" style={{ animationDelay: '0.4s' }} />
                  </div>
                </div>
              </div>
            )}
            <div ref={messagesEndRef} />
          </div>

          {/* Input */}
          <form onSubmit={handleSubmit} className="p-4 border-t border-[var(--border-color)]">
            <div className="flex gap-2">
              <input
                type="text"
                value={input}
                onChange={(e) => setInput(e.target.value)}
                placeholder="Ask your study question..."
                className="flex-1 px-4 py-2 rounded-lg bg-[var(--sidebar-bg)] border border-[var(--border-color)] focus:outline-none focus:ring-2 focus:ring-[var(--accent)]"
                disabled={loading}
              />
              <button
                type="submit"
                disabled={!input.trim() || loading}
                className="px-4 py-2 bg-[var(--accent)] text-white rounded-lg hover:bg-[var(--accent-light)] disabled:opacity-50 disabled:cursor-not-allowed"
              >
                <Send size={18} />
              </button>
            </div>
          </form>
        </>
      )}
    </div>
  );
}