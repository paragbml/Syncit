
import React, { useState } from 'react';
import { X, Link2, Image, ExternalLink, Plus, ChevronDown, ChevronRight } from 'lucide-react';

export default function ResourcePanel({ resources, onUpdateResources, onAddResource }) {
  const [isExpanded, setIsExpanded] = useState(true);
  const [editingIndex, setEditingIndex] = useState(null);
  const [editingResource, setEditingResource] = useState({ title: '', url: '', type: 'link' });

  const toggleExpanded = () => {
    setIsExpanded(!isExpanded);
  };

  const handleEdit = (index) => {
    setEditingIndex(index);
    setEditingResource(resources[index]);
  };

  const handleDelete = (index) => {
    const newResources = [...resources];
    newResources.splice(index, 1);
    onUpdateResources(newResources);
  };

  const handleSave = () => {
    if (!editingResource.title || !editingResource.url) return;

    let newResources;
    if (editingIndex !== null) {
      newResources = [...resources];
      newResources[editingIndex] = editingResource;
    } else {
      newResources = [...resources, editingResource];
    }

    onUpdateResources(newResources);
    setEditingIndex(null);
    setEditingResource({ title: '', url: '', type: 'link' });
  };

  const handleCancel = () => {
    setEditingIndex(null);
    setEditingResource({ title: '', url: '', type: 'link' });
  };

  const handleAddClick = (type) => {
    setEditingIndex(null);
    setEditingResource({ title: '', url: '', type });
  };

  const handleOpenLink = (url) => {
    try {
      let secureUrl = url;
      if (!url.startsWith('http://') && !url.startsWith('https://')) {
        secureUrl = 'https://' + url;
      }
      
      window.open(secureUrl, '_blank', 'noopener,noreferrer');
    } catch (error) {
      console.error('Error opening URL:', error);
    }
  };

  if (resources.length === 0 && editingIndex === null && !editingResource.title && !editingResource.url) {
    return null;
  }

  return (
    <div className="mb-4 border rounded-md overflow-hidden bg-gray-50">
      <div 
        className="flex items-center justify-between p-2 bg-gray-100 cursor-pointer"
        onClick={toggleExpanded}
      >
        <div className="flex items-center text-sm font-medium text-gray-700">
          {isExpanded ? <ChevronDown size={16} /> : <ChevronRight size={16} />}
          <span className="ml-1">Resources ({resources.length})</span>
        </div>
        {isExpanded && (
          <div className="flex space-x-1">
            <button 
              onClick={(e) => { e.stopPropagation(); handleAddClick('link'); }}
              className="p-1 rounded hover:bg-gray-200"
              title="Add Link"
            >
              <Link2 size={14} />
            </button>
            <button 
              onClick={(e) => { e.stopPropagation(); handleAddClick('image'); }}
              className="p-1 rounded hover:bg-gray-200"
              title="Add Image"
            >
              <Image size={14} />
            </button>
          </div>
        )}
      </div>

      {isExpanded && (
        <div className="p-2">
          {resources.length === 0 && editingIndex === null && !editingResource.title && !editingResource.url ? (
            <div className="text-center text-gray-500 text-sm py-2">
              No resources added yet
            </div>
          ) : (
            <ul className="space-y-2">
              {resources.map((resource, index) => (
                <li 
                  key={index}
                  className={`p-2 rounded-md ${editingIndex === index ? 'bg-blue-50' : 'bg-white'} border flex items-center justify-between`}
                >
                  {editingIndex === index ? (
                    <div className="w-full space-y-2">
                      <input
                        type="text"
                        value={editingResource.title}
                        onChange={(e) => setEditingResource({...editingResource, title: e.target.value})}
                        placeholder="Title"
                        className="w-full p-1 border rounded text-sm"
                      />
                      <input
                        type="text"
                        value={editingResource.url}
                        onChange={(e) => setEditingResource({...editingResource, url: e.target.value})}
                        placeholder="URL"
                        className="w-full p-1 border rounded text-sm"
                      />
                      <div className="flex justify-end space-x-2">
                        <button 
                          onClick={handleCancel}
                          className="px-2 py-1 text-xs rounded bg-gray-200 hover:bg-gray-300"
                        >
                          Cancel
                        </button>
                        <button 
                          onClick={handleSave}
                          className="px-2 py-1 text-xs rounded bg-blue-500 text-white hover:bg-blue-600"
                        >
                          Save
                        </button>
                      </div>
                    </div>
                  ) : (
                    <>
                      <div className="flex items-center">
                        {resource.type === 'link' ? (
                          <Link2 size={14} className="mr-2 text-blue-500" />
                        ) : (
                          <Image size={14} className="mr-2 text-green-500" />
                        )}
                        <span className="text-sm font-medium">{resource.title}</span>
                      </div>
                      <div className="flex space-x-1">
                        <button 
                          onClick={(e) => {
                            e.stopPropagation();
                            handleOpenLink(resource.url);
                          }}
                          className="p-1 rounded hover:bg-[var(--sidebar-hover)]"
                        >
                          <ExternalLink size={14} className="text-[var(--text-secondary)]" />
                        </button>
                        <button 
                          onClick={() => handleEdit(index)}
                          className="p-1 rounded hover:bg-[var(--sidebar-hover)]"
                        >
                          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" className="text-[var(--text-secondary)]">
                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                          </svg>
                        </button>
                        <button 
                          onClick={() => handleDelete(index)}
                          className="p-1 rounded hover:bg-[var(--sidebar-hover)]"
                        >
                          <X size={14} className="text-red-500" />
                        </button>
                      </div>
                    </>
                  )}
                </li>
              ))}

              {(editingIndex === null && (editingResource.title || editingResource.url)) && (
                <li className="p-2 rounded-md bg-blue-50 border space-y-2">
                  <input
                    type="text"
                    value={editingResource.title}
                    onChange={(e) => setEditingResource({...editingResource, title: e.target.value})}
                    placeholder="Title"
                    className="w-full p-1 border rounded text-sm"
                  />
                  <input
                    type="text"
                    value={editingResource.url}
                    onChange={(e) => setEditingResource({...editingResource, url: e.target.value})}
                    placeholder="URL"
                    className="w-full p-1 border rounded text-sm"
                  />
                  <div className="flex justify-end space-x-2">
                    <button 
                      onClick={handleCancel}
                      className="px-2 py-1 text-xs rounded bg-gray-200 hover:bg-gray-300"
                    >
                      Cancel
                    </button>
                    <button 
                      onClick={handleSave}
                      className="px-2 py-1 text-xs rounded bg-blue-500 text-white hover:bg-blue-600"
                    >
                      Add
                    </button>
                  </div>
                </li>
              )}
            </ul>
          )}
        </div>
      )}
    </div>
  );
}
