
import React, { useState, useEffect } from "react";
import NotesList from "../components/NotesList";
import PerplexityChat from "../components/chat/PerplexityChat";
import { X, Bot } from 'lucide-react';

export default function Notes() {
  const [selectedFolder, setSelectedFolder] = useState("All Notes");
  const [showChat, setShowChat] = useState(true);

  return (
    <div className="flex h-full">
      <div className={`flex-1 flex ${showChat ? 'md:mr-[400px]' : ''}`}>
        <NotesList folder={selectedFolder} />
        <div className="flex-1 hidden md:flex items-center justify-center bg-[var(--sidebar-bg)] text-[var(--text-secondary)] border-l border-[var(--border-color)]">
          <div className="text-center">
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1" strokeLinecap="round" strokeLinejoin="round" className="mx-auto mb-4 text-[var(--text-secondary)]">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
              <polyline points="10 9 9 9 8 9"></polyline>
            </svg>
            <p className="text-lg">Select a note to view</p>
            <p className="text-sm">or create a new one</p>
          </div>
        </div>
      </div>
      
      {/* Fixed Chat Panel */}
      <div 
        className={`fixed right-0 top-0 bottom-0 w-[400px] transition-transform duration-300 transform md:transform-none ${
          showChat ? 'translate-x-0' : 'translate-x-full'
        }`}
      >
        <PerplexityChat />
      </div>

      {/* Toggle Button */}
      <button
        onClick={() => setShowChat(!showChat)}
        className="fixed bottom-4 right-4 md:right-[420px] z-10 p-2 rounded-full bg-[var(--accent)] text-white shadow-lg"
      >
        {showChat ? <X size={20} /> : <Bot size={20} />}
      </button>
    </div>
  );
}
